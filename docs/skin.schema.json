{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LaTeX Question Bank skin v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "mode",
    "tokens",
    "options"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
      "not": {
        "enum": [
          "sheet",
          "porcelain",
          "darkroom",
          "pine"
        ]
      }
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "mode": {
      "enum": [
        "light",
        "dark"
      ]
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "chrome",
        "text",
        "dim",
        "border",
        "borderStrong",
        "accent",
        "onAccent",
        "active",
        "activeLine",
        "field",
        "well",
        "raised",
        "raisedSolid",
        "scrim",
        "codeBg",
        "syntax",
        "previewBg",
        "page",
        "pageInk",
        "must",
        "onMust",
        "recheck",
        "recheckSoft",
        "skip",
        "unset",
        "unsetLine",
        "danger",
        "success",
        "warning"
      ],
      "properties": {
        "surface": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "chrome": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "text": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "dim": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "border": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "borderStrong": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "onAccent": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "active": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "activeLine": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "field": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "well": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "raised": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "raisedSolid": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "scrim": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "codeBg": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "syntax": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "previewBg": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "page": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "pageInk": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "must": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "onMust": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "recheck": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "recheckSoft": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "skip": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "unset": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "unsetLine": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "danger": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "success": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "warning": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nav",
        "preview",
        "density",
        "headingFont",
        "radius"
      ],
      "properties": {
        "nav": {
          "enum": [
            "rail",
            "railIcons",
            "top",
            "topCentered"
          ]
        },
        "preview": {
          "enum": [
            "flat",
            "sheet",
            "paper"
          ]
        },
        "density": {
          "enum": [
            "comfortable",
            "compact"
          ]
        },
        "headingFont": {
          "enum": [
            "sans",
            "book"
          ]
        },
        "radius": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      }
    }
  }
}
